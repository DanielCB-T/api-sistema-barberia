APP_NAME=TUSINICIALESact4t4
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_sistema_barberia
DB_USERNAME=jdcb
DB_PASSWORD=2105030201*

# URL del frontend en React que consumirá esta API. Se usa en el correo de
# "recuperar contraseña" y en la redirección tras verificar el correo.
# En local suele ser el puerto de Vite.
FRONTEND_URL=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Correo. Para VERIFICACIÓN DE CORREO y RECUPERAR CONTRASEÑA necesitas un
# mailer real. En desarrollo puedes dejar # ---------------------------------------------------------------------------
# Correo — REQUERIDO para que la VERIFICACIÓN de correo se ENVÍE de verdad.
# Con MAIL_MAILER=log el correo NO se envía (solo se escribe en el log).
#
# Opción A (recomendada, sin instalar nada): SMTP de Brevo (gratis 300/día).
#   1) Crea cuenta en https://www.brevo.com  ->  SMTP & API  ->  SMTP.
#   2) Copia tu "login" y la "SMTP key" y ponlos abajo.
#   3) Verifica un remitente en Brevo y úsalo en MAIL_FROM_ADDRESS.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""

# Opción B: Gmail (necesitas 2FA activo + "Contraseña de aplicación"):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucorreo@gmail.com
#   MAIL_PASSWORD=xxxxxxxxxxxxxxxx   (app password de 16 caracteres, sin espacios)
#   MAIL_SCHEME=null
#   MAIL_FROM_ADDRESS="tucorreo@gmail.com"
#
# Opción C (API HTTP): Resend. Requiere: composer require resend/resend-php
#   MAIL_MAILER=resend
#   RESEND_KEY=re_xxxxxxxxxxxxxxxx
#   MAIL_FROM_ADDRESS="no-reply@tudominio.com"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Brevo (SMS transaccional) — confirmación de citas.
# Consigue tu API key en https://app.brevo.com/settings/keys/api
#  - BREVO_SMS_ENABLED: pon true para enviar SMS reales.
#  - BREVO_API_KEY: API key de tu cuenta de Brevo.
#  - BREVO_SMS_SENDER: remitente alfanumérico, máx. 11 caracteres, sin espacios.
#  - BREVO_DEFAULT_COUNTRY_CODE: se antepone a teléfonos de 10 dígitos.
# Si BREVO_SMS_ENABLED=false, la confirmación se registra en el log y la
# notificación queda como "fallido", sin romper el flujo de agendar cita.
# ---------------------------------------------------------------------------
BREVO_SMS_ENABLED=false
BREVO_API_KEY=
BREVO_SMS_SENDER=Barberia
BREVO_DEFAULT_COUNTRY_CODE=52
