REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Correo. Para VERIFICACIÓN DE CORREO y RECUPERAR CONTRASEÑA necesitas un
# mailer real. En desarrollo puedes dejar # ---------------------------------------------------------------------------
# Correo — REQUERIDO para que la VERIFICACIÓN de correo se ENVÍE de verdad.
# Con MAIL_MAILER=log el correo NO se envía (solo se escribe en el log).
#
# Opción A (recomendada, sin instalar nada): SMTP de Brevo (gratis 300/día).
#   1) Crea cuenta en https://www.brevo.com  ->  SMTP & API  ->  SMTP.
#   2) Copia tu "login" y la "SMTP key" y ponlos abajo.
#   3) Verifica un remitente en Brevo y úsalo en MAIL_FROM_ADDRESS.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu-login@brevo.com
MAIL_PASSWORD=tu-smtp-key-de-brevo
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Opción B: Gmail (necesitas 2FA activo + "Contraseña de aplicación"):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucorreo@gmail.com
#   MAIL_PASSWORD=xxxxxxxxxxxxxxxx   (app password de 16 caracteres, sin espacios)
#   MAIL_SCHEME=null
#   MAIL_FROM_ADDRESS="tucorreo@gmail.com"
#
# Opción C (API HTTP): Resend. Requiere: composer require resend/resend-php
#   MAIL_MAILER=resend
#   RESEND_KEY=re_xxxxxxxxxxxxxxxx
#   MAIL_FROM_ADDRESS="no-reply@tudominio.com"

# ---------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Cloud API) — confirmación de citas.
# Consíguelos en https://developers.facebook.com/ (WhatsApp > API Setup).
#  - WHATSAPP_ENABLED: pon true para enviar mensajes reales.
#  - WHATSAPP_TOKEN: token de acceso (permanente o temporal).
#  - WHATSAPP_PHONE_NUMBER_ID: ID del número emisor.
#  - WHATSAPP_DEFAULT_COUNTRY_CODE: se antepone a teléfonos de 10 dígitos.
# Si WHATSAPP_ENABLED=false, la confirmación se registra en el log y la
# notificación queda como "fallido", sin romper el flujo de agendar cita.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=true
