APP_NAME=TUSINICIALESact4t4
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# URL del frontend en React que consumirá esta API (usada en el correo de
# "recuperar contraseña"). En local suele ser el puerto de Vite.
FRONTEND_URL=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Claves de prueba (sandbox) de Stripe: https://dashboard.stripe.com/test/apikeys
# El webhook secret se obtiene al crear el endpoint en modo de prueba,
# o con `stripe listen --forward-to localhost/api/payments/webhook`.
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio: https://console.twilio.com (usa el WhatsApp Sandbox mientras no
# tengas un número de WhatsApp Business verificado).
TWILIO_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SMS_FROM=+1...

# Correo real vía Postfix propio en el VPS (ver docs/postfix-spf-dkim.md).
# En producción cambia MAIL_MAILER a "smtp" y ajusta MAIL_HOST al Postfix
# del VPS (normalmente 127.0.0.1 si Laravel corre en el mismo servidor).
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=25
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS=notificaciones@tudominio.com
