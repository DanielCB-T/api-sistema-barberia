APP_NAME=TUSINICIALESact4t4
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# URL del frontend en React que consumirá esta API. Se usa en el correo de
# "recuperar contraseña" y en la redirección tras verificar el correo.
# En local suele ser el puerto de Vite.
FRONTEND_URL=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Correo. Para VERIFICACIÓN DE CORREO y RECUPERAR CONTRASEÑA necesitas un
# mailer real. En desarrollo puedes dejar MAIL_MAILER=log (el correo se
# escribe en storage/logs/laravel.log) o usar Mailtrap. En producción,
# configura SMTP (Gmail, SendGrid, etc.).
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Cloud API) — confirmación de citas.
# Consíguelos en https://developers.facebook.com/ (WhatsApp > API Setup).
#  - WHATSAPP_ENABLED: pon true para enviar mensajes reales.
#  - WHATSAPP_TOKEN: token de acceso (permanente o temporal).
#  - WHATSAPP_PHONE_NUMBER_ID: ID del número emisor.
#  - WHATSAPP_DEFAULT_COUNTRY_CODE: se antepone a teléfonos de 10 dígitos.
# Si WHATSAPP_ENABLED=false, la confirmación se registra en el log y la
# notificación queda como "fallido", sin romper el flujo de agendar cita.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=EAAYhHZBO8hvABSE6jPfO6BWtGZAwFvqzOvVRORm6ZBywW5iTiPLl4qb1QEHX23oZCPULdGf3eEBBhtzkCaZC8h6z9RePfJexuUCWmcVchoIQHaUb8xlQKBF0a1qanUfTwGqa57qW4spr6lUA>
WHATSAPP_PHONE_NUMBER_ID=1188470614355625
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=52

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
