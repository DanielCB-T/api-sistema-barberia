meta {
  name: Actualizar noticia (admin)
  type: http
  seq: 4
}

put {
  url: http://177.7.32.156/api-sistema-barberia/api/news/{{news_id_created}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Promocion de verano (actualizada)",
    "summary": "25% en cortes.",
    "date": "2026-08-05"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
