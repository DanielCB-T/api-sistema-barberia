meta {
  name: Crear servicio (admin)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/services
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Corte + Barba",
    "category": "Corte",
    "price": 220,
    "duration": 45,
    "description": "Combo completo"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("service_id_created", res.getBody().data.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
