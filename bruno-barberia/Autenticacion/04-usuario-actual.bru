meta {
  name: Usuario actual (me)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/user
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("trae el email", function() {
    expect(res.getBody().data.email).to.be.a("string");
  });
}
