meta {
  name: Recuperar contraseña (forgot)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}"
  }
}

tests {
  test("responde 200 o 422 (segun config de correo)", function() {
    expect([200,422]).to.include(res.getStatus());
  });
}

docs {
  Envia enlace de reseteo. Requiere mailer configurado; si no, puede dar 422.
}
