meta {
  name: Login Admin
  type: http
  seq: 2
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().token);
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve token", function() {
    expect(res.getBody().token).to.be.a("string");
  });
}

docs {
  Inicia sesion como admin y guarda el token en la variable de entorno {{token}}.
}
