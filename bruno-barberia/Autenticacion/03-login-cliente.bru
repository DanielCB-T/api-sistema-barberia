meta {
  name: Login Cliente
  type: http
  seq: 3
}

post {
  url: http://177.7.32.156/api-sistema-barberia/api/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{client_email}}",
    "password": "{{client_password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("client_token", res.getBody().token);
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("guarda client_token", function() {
    expect(res.getBody().token).to.be.a("string");
  });
}

docs {
  Inicia sesion como cliente y guarda {{client_token}}.
}
