meta {
  name: Eliminar item del carrito
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/cart/items/{{cart_item_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{client_token}}
}

tests {
  test("200, o 404 si no existe", function() {
    expect([200,404]).to.include(res.getStatus());
  });
}
