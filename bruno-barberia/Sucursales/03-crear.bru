meta {
  name: Crear sucursal (admin)
  type: http
  seq: 3
}

post {
  url: http://177.7.32.156/api-sistema-barberia/api/branches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Sucursal Centro",
    "address": "Av. Juarez 100, Centro",
    "phone": "9512223344",
    "opening_time": "09:00",
    "closing_time": "20:00"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("branch_id_created", res.getBody().data.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
