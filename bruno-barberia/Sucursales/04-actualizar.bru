meta {
  name: Actualizar sucursal (admin)
  type: http
  seq: 4
}

put {
  url: {{base_url}}/branches/{{branch_id_created}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Sucursal Centro Historico",
    "address": "Av. Juarez 120",
